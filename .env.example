# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.

SENDER_EMAIL=you@gmail.com
SENDER_PASSWORD=your_gmail_app_password
RECEIVER_EMAIL=you@gmail.com

# eBay Browse API credentials (developer.ebay.com, production keyset)
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret

# Optional: use a different database file (default is src/raincheck.db)
# RAINCHECK_DB_PATH=/tmp/raincheck-test.db

# Optional: print emails instead of sending them (any value except 0/false/no/off turns it on)
# RAINCHECK_DRY_RUN=1
